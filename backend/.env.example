# ── Database ──
DATABASE_URL=postgresql+asyncpg://stylify:stylify_pass@localhost:5432/stylify_db

# ── JWT ──
SECRET_KEY=change-me-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── App ──
APP_ENV=development
DEBUG=true

# ── Email / SMTP (dev: console or Mailtrap) ──
EMAIL_BACKEND=console
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM_EMAIL=noreply@stylify.salon
SMTP_FROM_NAME=Stylify Salon
SMTP_TLS=true

